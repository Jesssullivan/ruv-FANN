# ruv-FANN Production Container
# Optimized, consolidated build for Podman/K8s deployment

FROM node:20-alpine AS builder

# Install build essentials
RUN apk add --no-cache \
    python3 python3-dev \
    gcc g++ make \
    git curl jq \
    rust cargo

# Install WASM tools
RUN cargo install wasm-pack

WORKDIR /app

# Copy and install dependencies
COPY package*.json ./
COPY ruv-swarm/npm/package*.json ./ruv-swarm/npm/
RUN npm ci --production=false

# Copy source and build
COPY . .
RUN cd ruv-swarm && \
    cargo build --release --target wasm32-unknown-unknown && \
    wasm-pack build --target nodejs --out-dir npm/wasm

# Production stage
FROM node:20-alpine

# Install runtime dependencies
RUN apk add --no-cache \
    python3 \
    postgresql-client \
    redis \
    syncthing \
    curl jq

# Create non-root user
RUN addgroup -g 1000 fann && \
    adduser -D -u 1000 -G fann fann

WORKDIR /app

# Copy built application
COPY --from=builder --chown=fann:fann /app/node_modules ./node_modules
COPY --from=builder --chown=fann:fann /app/ruv-swarm ./ruv-swarm
COPY --chown=fann:fann package*.json ./
COPY --chown=fann:fann mcp-server ./mcp-server
COPY --chown=fann:fann scripts/docker-entrypoint.sh ./

# Create data directories
RUN mkdir -p /data/{models,sync,cache,memory} && \
    chown -R fann:fann /data

# Environment
ENV NODE_ENV=production \
    MCP_SERVER_PORT=3000 \
    REDIS_URL=redis://localhost:6379 \
    POSTGRES_URL=postgresql://fann:fann123@localhost:5432/fanndb \
    SYNCTHING_API=http://localhost:8384 \
    WASM_SIMD_ENABLED=true

USER fann

EXPOSE 3000 8384 22000 21027/udp

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

ENTRYPOINT ["./docker-entrypoint.sh"]