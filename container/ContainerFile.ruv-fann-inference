# RUV-FANN Inference Service Container
# Optimized for high-throughput, low-latency inference

FROM rust:1.81-alpine AS rust-builder

# Install build dependencies
RUN apk add --no-cache \
    gcc g++ musl-dev linux-headers \
    pkgconfig openssl-dev

WORKDIR /app

# Copy dependency manifests
COPY Cargo.toml Cargo.lock ./
COPY src/lib.rs src/lib.rs

# Pre-build dependencies
RUN cargo build --release --features="default,wasm,parallel" && \
    rm -rf src/

# Copy source code
COPY src/ ./src/
COPY cuda-wasm/ ./cuda-wasm/

# Build inference-optimized binary
RUN cargo build --release --bin ruv-fann-inference --features="default,wasm,parallel,inference-optimized"

# Node.js builder for API server
FROM node:20-alpine AS node-builder

WORKDIR /app

# Copy package files
COPY inference-service/package*.json ./

# Install dependencies
RUN npm ci --only=production

# Copy and build inference service
COPY inference-service/src/ ./src/
COPY inference-service/tsconfig.json ./

RUN npm run build

# Runtime stage
FROM alpine:3.19 AS runtime

# Install minimal runtime dependencies
RUN apk add --no-cache \
    libgcc libstdc++ \
    nodejs npm \
    curl jq \
    ca-certificates

# Create app user
RUN addgroup -g 1000 inference && \
    adduser -D -s /bin/sh -u 1000 -G inference inference

# Create application directories
RUN mkdir -p /opt/inference/{bin,lib,models,cache} && \
    mkdir -p /tmp/inference && \
    chown -R inference:inference /opt/inference /tmp/inference

# Copy Rust inference binary
COPY --from=rust-builder /app/target/release/ruv-fann-inference /opt/inference/bin/

# Copy Node.js API server
COPY --from=node-builder /app/dist/ /opt/inference/lib/
COPY --from=node-builder /app/node_modules/ /opt/inference/lib/node_modules/

# Copy scripts and configs
COPY scripts/inference-entrypoint.sh /opt/inference/bin/
COPY scripts/inference-health.sh /opt/inference/bin/
COPY config/inference.toml /opt/inference/config/

RUN chmod +x /opt/inference/bin/*

# Set up environment
ENV PATH="/opt/inference/bin:${PATH}"
ENV NODE_PATH="/opt/inference/lib/node_modules"
ENV RUST_LOG=info
ENV INFERENCE_CONFIG="/opt/inference/config/inference.toml"
ENV INFERENCE_MODELS_PATH="/opt/inference/models"
ENV INFERENCE_CACHE_PATH="/opt/inference/cache"
ENV INFERENCE_BATCH_SIZE=32
ENV INFERENCE_MAX_QUEUE=1000
ENV INFERENCE_TIMEOUT=30

# Switch to app user
USER inference

WORKDIR /opt/inference

# Expose port
EXPOSE 8080

# Health check optimized for inference
HEALTHCHECK --interval=15s --timeout=5s --retries=2 --start-period=30s \
    CMD /opt/inference/bin/inference-health.sh

ENTRYPOINT ["/opt/inference/bin/inference-entrypoint.sh"]
CMD ["serve"]